---
// Contact section for Innovation Nexus Consulting
import ContactModal from './ContactModal.astro';
---

<section id="contact" class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-gray-900 mb-4">
        Get what you need
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Rise to the challenge, get the result you need.  
        Get in touch and we can explore options, set the plan and deliver, from designing a study, to tactical and strategic engagement.
      </p>
    </div>

    <!-- Centered Buttons Section -->
    <div class="flex justify-center w-full mt-8">
      <div class="flex flex-col sm:flex-row gap-6 max-w-2xl w-full justify-center">
        <div class="bg-white border border-gray-300 shadow-lg rounded-xl p-6 text-center flex-1 max-w-xs">
          <button
            class="border-2 border-orange-600 text-orange-600 hover:bg-orange-600 hover:text-white py-3 px-6 rounded-lg font-medium transition-all duration-200 flex items-center justify-center gap-3 w-full"
            onclick="openContactModal()"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span>Send Email</span>
          </button>
        </div>

        <div class="bg-white border border-gray-300 shadow-lg rounded-xl p-6 text-center flex-1 max-w-xs">
          <button
            class="border-2 border-orange-600 text-orange-600 hover:bg-orange-600 hover:text-white py-3 px-6 rounded-lg font-medium transition-all duration-200 flex items-center justify-center gap-3 w-full"
            onclick="window.open('https://linkedin.com/in/roy-williamson', '_blank')"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>Connect</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Contact Modal -->
<ContactModal />
